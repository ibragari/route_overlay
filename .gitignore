# Generated / cached data
/tile_cache/
trip.gpx

# Your personal settings -- copy overlay_config.yml.default to this filename
# once and edit it; kept out of git since it can end up holding real
# locations (route.privacy_zones) or other per-user preferences.
/overlay_config.yml

# Rendered overlay output (final renders + intermediate work files)
/overlays/
/overlays_test/
test/overlays/

# Source dashcam footage and other video files -- not part of the project
*.mp4
*.MP4

# Ad-hoc screenshots
Screenshot*.png

# Early scratch/debug scripts, superseded by lib/novatek_gps.rb
decode_record.rb
gpx.fmt
cfg_dynzoom.yml

# Local tool settings
/.claude/

# Optional vendored libvips binaries (see lib/vips_support.rb) -- large,
# platform-specific, fetched on demand, not part of the source
/vendor/

# Reference clone of another project (gopro-dashboard-overlay), not part of
# this one -- it's its own git repo
/gopro-dashboard-overlay/
