# Dashcam GPS overlay - render configuration.
# Edit values below. Each setting lists its valid choices in a comment.

trip:
  gpx_file: trip.gpx            # output of gps_extractor.rb
  clips_dir: .                  # folder containing source MP4 clips
  utc_offset_hours: 0           # must match what you passed to gps_extractor.rb

output:
  mode: per_clip                # per_clip | merged
  resolution: "3840x2160"       # WxH of your edit timeline -- NOT baked into the render (which is inset-only,
                                 # for a ~50x smaller/faster file); used only to print a suggested Resolve
                                 # Transform position matching inset.corner/margin_px below
  fps: 60                       # set to match your actual edit timeline, not the source clips
  codec: prores4444             # prores4444 | png_sequence
  directory: ./overlays
  parallel_clips: 1             # how many clips of a trip to render at once (per_clip mode, no explicit clip
                                 # argument only -- ignored otherwise). 1 = today's one-at-a-time behavior. Each
                                 # clip beyond the first spawns its own `ruby overlay_generator.rb` process (no
                                 # fork on Windows), so this only helps if your machine has CPU/RAM headroom to
                                 # spare -- start low and watch usage before raising it.

map:
  tile_provider: osm            # osm | carto_positron | carto_dark_matter | carto_voyager | custom -- each
                                 # provider caches to its own tile_cache_dir subfolder, so switching between
                                 # them never mixes tiles. The carto_* presets need tile_api_key below (free,
                                 # fair-use tier -- get one at https://carto.com/basemaps/apikey); without it
                                 # they serve a watermarked "API key required" tile instead of the real map.
  custom_tile_url_template: ""  # only used when tile_provider: custom, e.g. "https://.../{z}/{x}/{y}.png"
  tile_api_key:                 # per-provider-family API keys -- only the one(s) actually needed are read
    carto: ""                   # used by all carto_* presets (they share one CARTO account/key)
    custom: ""                  # only used when tile_provider: custom, if that provider needs a key
  tile_cache_dir: ./tile_cache
  # rotation_mode: north_up     # north_up | heading_up -- INERT: not read by any code yet (map is always
                                 # rendered north-up); heading_up isn't implemented. See README's "What's not done yet".

  window_mode: fixed_radius     # fixed_radius | fixed_zoom | dynamic_speed -- only the matching block below is used

  fixed_radius:
    radius_meters: 200          # constant real-world radius shown around current position, regardless of speed

  fixed_zoom:
    zoom_level: 16               # constant OSM tile zoom level -- felt scale then depends on inset size_px

  dynamic_speed:
    min_radius_meters: 150      # radius shown while stopped / moving slowly
    max_radius_meters: 600      # radius shown at or above max_speed_kmh
    min_speed_kmh: 10           # radius stays at min_radius_meters at or below this speed (a "dead zone" before
                                 # zooming out starts); 0 disables, matching max_speed_kmh's own zero point
    max_speed_kmh: 80           # speed at which max_radius_meters is reached; scales below this per curve_exponent
    curve_exponent: 1           # reshapes how radius ramps from min_radius_meters to max_radius_meters across
                                 # min_speed_kmh..max_speed_kmh: 1 (default) is a straight line; >1 keeps the radius
                                 # close to min_radius_meters through low/mid speeds and only grows quickly near
                                 # max_speed_kmh; <1 grows fast early and flattens out later
    speed_smoothing_seconds: 4  # total width (seconds, >=0) of the centered time window averaged around each
                                 # point before mapping speed to zoom radius, to avoid frame-to-frame jitter from
                                 # noisy raw GPS speed and to smooth across clip boundaries; 0 disables. Wider =
                                 # smoother/more anticipatory but slower to reflect a sudden real speed change.

inset:
  size_px: 400                  # rendered clip is exactly size_px x size_px -- place at 1:1 scale in Resolve
  corner: bottom_right          # bottom_right | bottom_left | top_right | top_left -- informational only, used
                                 # (with margin_px and output.resolution) to print a suggested Resolve position
  margin_px: 40
  shape: rounded_rect           # rounded_rect | rect | circle
  border:
    enabled: true
    width_px: 4
    color: "#FFFFFFCC"

route:
  color: "#FF3B30"              # must be fully opaque (no alpha) -- see mosaic_renderer.rb's draw_thick_polyline!
  line_width_px: 2
  track_line_alpha: 1.0         # 0.0 (invisible) - 1.0 (fully opaque) -- opacity of the drawn route line
  privacy_zones: []             # zero or more circles the route line is never drawn inside (e.g. hide it near home) --
                                 # the line stops before entering one and resumes after leaving it, e.g.:
                                 # - center_lat: 47.123456
                                 #   center_lon: 28.123456
                                 #   radius_meters: 200

position_marker:
  enabled: true
  color: "#1A73E8"
  radius_px: 14
  outline_color: "#000000"
  outline_width_px: 2

# speed_hud:                    # NOT IMPLEMENTED YET -- no code reads or renders this section at all.
#   enabled: false
#   position: attached           # attached | separate_corner
#   unit: kmh                    # matches gps_extractor.rb's GPX <speed> unit

# extras: []                     # NOT IMPLEMENTED YET -- north_arrow, scale_bar, timestamp are not rendered.
